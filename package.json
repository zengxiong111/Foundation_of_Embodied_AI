{
  "name": "foundation-of-embodied-ai-materials",
  "private": true,
  "version": "1.0.0",
  "description": "Build and validate bilingual course PDFs from Markdown",
  "license": "SEE LICENSE IN LICENSE-CODE",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "python3 scripts/check.py",
    "check:online": "python3 scripts/publish.py --verify-only",
    "test": "python3 -m unittest discover -s tests",
    "sync": "python3 scripts/sync_docs.py"
  },
  "dependencies": {
    "gray-matter": "4.0.3",
    "katex": "0.19.0",
    "markdown-it": "15.0.3",
    "markdown-it-texmath": "1.0.0",
    "mermaid": "12.2.0",
    "playwright": "1.64.1"
  }
}
